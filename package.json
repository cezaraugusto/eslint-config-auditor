{
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cezaraugusto/eslint-config-auditor.git"
  },
  "name": "eslint-config-auditor",
  "version": "2.3.0",
  "description": "Shareable ESLint flat config to help you write clear, efficient JavaScript code.",
  "homepage": "https://www.npmjs.com/package/eslint-config-auditor",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./recommended": {
      "types": "./dist/recommended.d.ts",
      "import": "./dist/recommended.js",
      "require": "./dist/recommended.cjs"
    },
    "./finest": {
      "types": "./dist/finest.d.ts",
      "import": "./dist/finest.js",
      "require": "./dist/finest.cjs"
    },
    "./jest": {
      "types": "./dist/jest.d.ts",
      "import": "./dist/jest.js",
      "require": "./dist/jest.cjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js",
      "require": "./dist/vitest.cjs"
    },
    "./stylistic": {
      "types": "./dist/stylistic.d.ts",
      "import": "./dist/stylistic.js",
      "require": "./dist/stylistic.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./typescript": {
      "types": "./dist/typescript.d.ts",
      "import": "./dist/typescript.js",
      "require": "./dist/typescript.cjs"
    },
    "./typescript-checked": {
      "types": "./dist/typescript-checked.d.ts",
      "import": "./dist/typescript-checked.js",
      "require": "./dist/typescript-checked.cjs"
    },
    "./ts": {
      "types": "./dist/ts.d.ts",
      "import": "./dist/ts.js",
      "require": "./dist/ts.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CONSUMING.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "rslib build",
    "check": "biome check --write",
    "dev": "rslib build --watch",
    "format": "biome format --write",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "engineStrict": false,
  "publishConfig": {
    "provenance": true
  },
  "author": {
    "name": "Cezar Augusto",
    "email": "boss@cezaraugusto.net",
    "url": "https://cezaraugusto.net"
  },
  "keywords": [
    "check",
    "checker",
    "code",
    "code checker",
    "code linter",
    "code standards",
    "code quality",
    "code pattern",
    "code style",
    "enforce",
    "eslint",
    "eslintconfig",
    "eslint shareable config",
    "eslint flat config",
    "hint",
    "lint",
    "style checker",
    "style linter",
    "verify",
    "prettier",
    "standard",
    "alternative"
  ],
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/eslint-plugin": "^1.6.20",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.61.0"
  },
  "peerDependencies": {
    "eslint": ">=10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@rslib/core": "^0.22.1",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "jest": "^30.4.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@9.9.0",
  "bugs": "https://github.com/cezaraugusto/eslint-config-auditor/issues",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "vite": ">=7.3.5",
      "vitest": ">=3.2.6",
      "rollup": ">=4.59.0",
      "minimatch": ">=9.0.7",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.10",
      "js-yaml": ">=4.2.0",
      "brace-expansion": ">=2.0.2",
      "tmp": ">=0.2.6"
    }
  }
}
